{
  "name": "shadcn-ui-website",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter=v4 dev",
    "build": "pnpm --filter=v4 build",
    "pages:build": "pnpm --filter=v4 build",
    "pages:deploy": "pnpm pages:build && pnpm exec wrangler pages deploy apps/v4/out --project-name shadcn-ui-jp",
    "start": "pnpm --filter=v4 start",
    "lint": "pnpm --filter=v4 lint",
    "lint:fix": "pnpm --filter=v4 lint:fix",
    "typecheck": "pnpm --filter=v4 typecheck",
    "format:write": "pnpm --filter=v4 format:write",
    "format:check": "pnpm --filter=v4 format:check",
    "preview": "pnpm --filter=v4 preview",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "wrangler": "^4.132.0"
  }
}
